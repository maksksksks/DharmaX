diff --git a/components/app_core/app_events.c b/components/app_core/app_events.c
index be2bdd7..adbfb98 100644
--- a/components/app_core/app_events.c
+++ b/components/app_core/app_events.c
@@ -1,5 +1,27 @@
+#include <stddef.h>
 #include "app_events.h"
 #include "esp_event.h"
 
 // Определяем базу событий (реальная инициализация "радиостанции")
-ESP_EVENT_DEFINE_BASE(APP_EVENTS);
\ No newline at end of file
+ESP_EVENT_DEFINE_BASE(APP_EVENTS);
+
+esp_err_t app_evt_subscribe(app_evt_sub_t *sub, int32_t id, esp_event_handler_t cb, void *arg)
+{
+    if (sub == NULL || cb == NULL) return ESP_ERR_INVALID_ARG;
+    if (sub->inst != NULL) return ESP_ERR_INVALID_STATE;
+
+    esp_event_handler_instance_t inst = NULL;
+    esp_err_t err = esp_event_handler_instance_register(APP_EVENTS, id, cb, arg, &inst);
+    if (err == ESP_OK) {
+        sub->id = id;
+        sub->inst = inst;
+    }
+    return err;
+}
+
+void app_evt_unsubscribe(app_evt_sub_t *sub)
+{
+    if (sub == NULL || sub->inst == NULL) return;
+    esp_event_handler_instance_unregister(APP_EVENTS, sub->id, sub->inst);
+    sub->inst = NULL;
+}
diff --git a/components/app_core/app_events.h b/components/app_core/app_events.h
index 498d988..d76d73c 100644
--- a/components/app_core/app_events.h
+++ b/components/app_core/app_events.h
@@ -121,3 +121,23 @@ typedef struct {
     bool charging;
     char carrier[16];        // имя оператора, может быть ""
 } phone_status_data_t;
+
+// ---------------------------------------------------------------------------
+// Подписка с запоминанием instance-хендла. Экраны (app_nav) хранят такие
+// записи у себя и в destroy() вызывают app_evt_unsubscribe() - это и есть
+// "снять ВСЕ esp_event_handler_instance_unregister".
+// ---------------------------------------------------------------------------
+typedef struct {
+    int32_t id;
+    esp_event_handler_instance_t inst;   // NULL = не подписан
+} app_evt_sub_t;
+
+// Подписывает cb на (APP_EVENTS, id). Повторный вызов на уже активной записи
+// возвращает ESP_ERR_INVALID_STATE (двойная подписка = утечка).
+esp_err_t app_evt_subscribe(app_evt_sub_t *sub, int32_t id, esp_event_handler_t cb, void *arg);
+
+// Идемпотентно: можно звать на неактивной/нулевой записи. Блокируется, пока
+// выполняется уже запущенный обработчик, поэтому после возврата обработчик
+// гарантированно не работает и больше не стартует.
+void app_evt_unsubscribe(app_evt_sub_t *sub);
+
